<%- include('../partials/header') %>
<%- include('../partials/navbar') %>
<main class="container">
  <%- include('../partials/alerts') %>
  <div class="page-heading">
    <h1>Eventos disponiveis</h1>
    <form method="GET" action="/eventos" class="search-form">
      <input type="text" name="busca" placeholder="Buscar por titulo ou local..." value="<%= busca %>">
      <button type="submit" class="btn btn-outline">Buscar</button>
    </form>
  </div>

  <div class="grid-cards">
    <% if (eventos.length === 0) { %>
      <p>Nenhum evento encontrado.</p>
    <% } %>
    <% eventos.forEach(evento => { %>
      <div class="card card-evento">
        <h3><%= evento.titulo %></h3>
        <p class="card-meta"> <%= new Date(evento.data_evento).toLocaleDateString('pt-BR') %> às <%= evento.horario %></p>
        <p class="card-meta"> <%= evento.local %></p>
        <p class="card-meta"> <%= evento.total_inscritos %>/<%= evento.capacidade %> vagas</p>
        <a href="/eventos/<%= evento.id %>" class="btn btn-primary btn-full">Ver detalhes</a>
      </div>
    <% }) %>
  </div>
</main>
<%- include('../partials/footer') %>