<%- include('../partials/header') %>
<%- include('../partials/navbar') %>
<main class="container container-form">
  <div class="card">
    <h1>Editar evento</h1>
    <%- include('../partials/alerts') %>
    <form method="POST" action="/eventos/<%= evento.id %>/editar">
      <label for="titulo">Titulo</label>
      <input type="text" id="titulo" name="titulo" value="<%= evento.titulo %>" required>

      <label for="descricao">Descricao</label>
      <textarea id="descricao" name="descricao" rows="4" required><%= evento.descricao %></textarea>

      <label for="data_evento">Data</label>
      <input type="date" id="data_evento" name="data_evento" value="<%= new Date(evento.data_evento).toISOString().split('T')[0] %>" required>

      <label for="horario">Horario</label>
      <input type="time" id="horario" name="horario" value="<%= evento.horario %>" required>

      <label for="local">Local</label>
      <input type="text" id="local" name="local" value="<%= evento.local %>" required>

      <label for="capacidade">Capacidade</label>
      <input type="number" id="capacidade" name="capacidade" min="1" value="<%= evento.capacidade %>" required>

      <button type="submit" class="btn btn-primary btn-full">Salvar alteracoes</button>
    </form>
  </div>
</main>
<%- include('../partials/footer') %>