<%- include('../partials/header') %>
<%- include('../partials/navbar') %>
<main class="container container-form">
  <%- include('../partials/alerts') %>
  <div class="card">
    <h1><%= evento.titulo %></h1>
    <p class="card-meta"> <%= new Date(evento.data_evento).toLocaleDateString('pt-BR') %> às <%= evento.horario %></p>
    <p class="card-meta"> <%= evento.local %></p>
    <p class="card-meta"> Organizado por <%= evento.organizador_nome %></p>
    <p class="card-meta"> <%= evento.total_inscritos %>/<%= evento.capacidade %> vagas preenchidas</p>
    <hr>
    <p><%= evento.descricao %></p>

    <% if (usuarioLogado && usuarioLogado.tipo === 'participante') { %>
      <% if (jaInscrito) { %>
        <p class="badge badge-sucesso">Voce ja esta inscrito neste evento</p>
      <% } else { %>
        <form method="POST" action="/eventos/<%= evento.id %>/inscrever">
          <button type="submit" class="btn btn-primary">Realizar inscricao</button>
        </form>
      <% } %>
    <% } else if (!usuarioLogado) { %>
      <p><a href="/auth/login">Entre</a> para se inscrever neste evento.</p>
    <% } %>
  </div>
</main>
<%- include('../partials/footer') %>